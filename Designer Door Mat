# N is height, M is width (M = 3 * N)
n, m = map(int, input().split())

# Top Section
for i in range(1, n, 2):
    pattern = (".|." * i)
    print(pattern.center(m, "-"))

# Middle Section
print("WELCOME".center(m, "-"))

# Bottom Section
for i in range(n-2, -1, -2):
    pattern = (".|." * i)
    print(pattern.center(m, "-"))
